# =============================================================================
# DocuWeave — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# TEMPLATE DATABASE
# Stores templates, transformations, selector configs, canvas layouts.
# Choose: postgres | mysql | mongodb
# ---------------------------------------------------------------------------
TEMPLATE_DB_TYPE=postgres
TEMPLATE_DB_URL=postgresql+asyncpg://docuweave:docuweave@localhost:5432/docuweave_templates
# If using MongoDB:
# TEMPLATE_DB_TYPE=mongodb
# TEMPLATE_DB_URL=mongodb://docuweave:docuweave@localhost:27017/docuweave_templates

# ---------------------------------------------------------------------------
# DATA DATABASE
# Raw data retrieval only. No templates stored here.
# Choose: postgres | mysql | mongodb
# ---------------------------------------------------------------------------
DATA_DB_TYPE=postgres
DATA_DB_URL=postgresql://docuweave:docuweave@localhost:5433/docuweave_data
# If using MySQL:
# DATA_DB_TYPE=mysql
# DATA_DB_URL=mysql://docuweave:docuweave@localhost:3306/docuweave_data
# If using MongoDB:
# DATA_DB_TYPE=mongodb
# DATA_DB_URL=mongodb://docuweave:docuweave@localhost:27017/docuweave_data

# ---------------------------------------------------------------------------
# BACKEND SERVER
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# ---------------------------------------------------------------------------
# FRONTEND
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
